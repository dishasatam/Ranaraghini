@page "/alerts"

@using Ranaraghini.Services
@using Ranaraghini.Data
@using Ranaraghini.Models

@inject SessionService SessionService
@inject NavigationManager Navigation
@inject AppDatabase Database

<PageTitle>Alert History</PageTitle>

<div class="alerts-page">

    <div class="alerts-header">

        <h1>🚨 Alert History</h1>

        <p>
            View all SOS alerts generated by the application.
        </p>

    </div>

    <div class="summary-card">

        <h3>Total Alerts</h3>

        <div class="alert-count">
            @alerts.Count
        </div>

    </div>

    <button class="refresh-btn"
            @onclick="LoadAlerts">

        Refresh Alerts

    </button>

    @if (alerts.Count == 0)
    {
        <div class="empty-alert">

            No SOS alerts found.

        </div>
    }
    else
    {
        <div class="alert-list">

            @foreach (var alert in alerts.OrderByDescending(x => x.AlertTime))
            {
                <div class="alert-card">

                    <h3>🚨 SOS ALERT</h3>

                    <p>
                        <strong>Message:</strong>
                        @alert.Message
                    </p>

                    

                    <p>
                        <strong>Date:</strong>
                        @alert.AlertTime
                    </p>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<AlertHistory> alerts = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsLoggedIn())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAlerts();
    }

    private async Task LoadAlerts()
    {
        alerts = await Database.GetAlertsAsync();

        StateHasChanged();
    }
}